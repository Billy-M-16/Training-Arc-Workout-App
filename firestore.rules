rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(code) {
      return request.auth != null
        && exists(/databases/$(database)/documents/squads/$(code)/members/$(request.auth.uid));
    }

    // Each person's own data: only they can read or write it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Squads: anyone signed in can look up a squad by its invite code (to join it).
    // Only the creator can rename or delete it.
    match /squads/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40;
      allow update, delete: if request.auth != null && resource.data.owner == request.auth.uid;

      // Workouts shared with the squad: members can read; you can share and remove your own;
      // the squad creator can remove any.
      match /workouts/{wid} {
        allow read: if isMember(code);
        // share your own workout (the squad level can't be set by the creator)
        allow create: if isMember(code)
          && request.resource.data.by == request.auth.uid
          && request.resource.data.workout is string
          && request.resource.data.workout.size() < 100000
          && !('ranked' in request.resource.data);
        allow update: if isMember(code)
          && resource.data.by == request.auth.uid
          && request.resource.data.by == request.auth.uid
          && request.resource.data.get('ranked', null) == resource.data.get('ranked', null);
        // any member can lock in the squad ranking once, and only that field
        allow update: if isMember(code)
          && resource.data.get('ranked', null) == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ranked'])
          && request.resource.data.ranked.level is int
          && request.resource.data.ranked.level >= 1
          && request.resource.data.ranked.level <= 5;
        allow delete: if request.auth != null
          && (resource.data.by == request.auth.uid
              || get(/databases/$(database)/documents/squads/$(code)).data.owner == request.auth.uid);

        // one level vote per member
        match /votes/{uid} {
          allow read: if isMember(code);
          allow write: if isMember(code) && request.auth.uid == uid
            && request.resource.data.level is int
            && request.resource.data.level >= 1 && request.resource.data.level <= 5;
        }
      }

      // Leaderboard entries: you can only write your own; only squad members can read them.
      match /members/{uid} {
        allow write: if request.auth != null && request.auth.uid == uid
          && exists(/databases/$(database)/documents/squads/$(code));
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/squads/$(code)/members/$(request.auth.uid));
      }
    }
  }
}
