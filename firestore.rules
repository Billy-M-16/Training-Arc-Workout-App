rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each person's own data: only they can read or write it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Squads: anyone signed in can look up a squad by its invite code (to join it).
    // Only the creator can rename or delete it.
    match /squads/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40;
      allow update, delete: if request.auth != null && resource.data.owner == request.auth.uid;

      // Workouts shared with the squad: members can read; you can share and remove your own;
      // the squad creator can remove any.
      match /workouts/{wid} {
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/squads/$(code)/members/$(request.auth.uid));
        allow create, update: if request.auth != null
          && request.resource.data.by == request.auth.uid
          && (resource == null || resource.data.by == request.auth.uid)
          && request.resource.data.workout is string
          && request.resource.data.workout.size() < 100000
          && exists(/databases/$(database)/documents/squads/$(code)/members/$(request.auth.uid));
        allow delete: if request.auth != null
          && (resource.data.by == request.auth.uid
              || get(/databases/$(database)/documents/squads/$(code)).data.owner == request.auth.uid);
      }

      // Leaderboard entries: you can only write your own; only squad members can read them.
      match /members/{uid} {
        allow write: if request.auth != null && request.auth.uid == uid
          && exists(/databases/$(database)/documents/squads/$(code));
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/squads/$(code)/members/$(request.auth.uid));
      }
    }
  }
}
